local function criarBotao(nome, x, cor, texto, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.43, 0, 0, 30)
    btn.Position = UDim2.new(x, 0, 0, 80)
    btn.BackgroundColor3 = cor
    btn.Text = texto
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = main
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    -- Efeito hover
    local hoverTween = TweenService:Create(btn, TweenInfo.new(0.2), {
        BackgroundColor3 = cor:Lerp(Color3.fromRGB(255, 255, 255), 0.15)
    })
    local leaveTween = TweenService:Create(btn, TweenInfo.new(0.2), {
        BackgroundColor3 = cor
    })
    
    btn.MouseEnter:Connect(function() hoverTween:Play() end)
    btn.MouseLeave:Connect(function() leaveTween:Play() end)
    
    btn.MouseButton1Click:Connect(callback)
    return btn
end

