    notifBorder.BackgroundTransparency = 1
    notifBorder.BorderSizePixel = 2
    notifBorder.BorderColor3 = cor or Color3.fromRGB(150, 50, 255)
    notifBorder.Parent = notif
    
    local notifText = Instance.new("TextLabel")
    notifText.Size = UDim2.new(1, -20, 1, 0)
    notifText.Position = UDim2.new(0, 10, 0, 0)
    notifText.BackgroundTransparency = 1
    notifText.Text = texto
    notifText.TextColor3 = Color3.fromRGB(255, 255, 255)
    notifText.TextScaled = true
    notifText.Font = Enum.Font.Gotham
    notifText.Parent = notif
    
    -- Animação de entrada
    notif.Position = UDim2.new(1, 10, 0, #notificacoes * 42 + 10)
    local tween = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Position = UDim2.new(0.85, 0, 0, #notificacoes * 42 + 10)
    })
    tween:Play()
    
    table.insert(notificacoes, notif)
    
    task.delay(3, function()
        local fade = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            BackgroundTransparency = 1
        })
        fade:Play()
        task.wait(0.3)
        notif:Destroy()
        for i, n in pairs(notificacoes) do
            if n == notif then table.remove(notificacoes, i) break end
        end
    end)
end

