local remote = ReplicatedStorage:WaitForChild("ByteNetReliable")
local espFolder = Instance.new("Folder", Workspace)
espFolder.Name = "DinoESP_Folder"

local function clearESP()
    for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end
end

local function createESP(part, text, color)
    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.new(0, 120, 0, 26)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.4
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.Parent = bb
end

local function isDino(name)
    local lower = string.lower(name)
    for _, key in ipairs(dinoKeywords) do
        if string.find(lower, key) then return true end
    end
    return false
end

local function getEquippedTool()
    if not Character then return nil end
    for _, item in pairs(Character:GetChildren()) do
        if item:IsA("Tool") then return item.Name end
    end
    return nil
end

local function fireTool(toolName, activated, pos)
    if not toolName then return end
    local args = {
        buffer.fromstring("\001\001"),
        {{"Tool", "Activated", toolName, activated, vector.create(pos.X, pos.Y, pos.Z)}}
    }
    pcall(function() remote:FireServer(unpack(args)) end)
end

local function getClosestTree()
    if not Root then return nil end
    local closest, shortest = nil, Config.AutoWood.Distance
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and treeNames[obj.Name] then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (Root.Position - part.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = part
                end
            end
        end
    end
    return closest
end

local function collectNearby()
    if not Root then return end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if woodNames[obj.Name] or fossilNames[obj.Name] then
            local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
            if part and (Root.Position - part.Position).Magnitude < 25 then
                local prompt = part:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then pcall(fireproximityprompt, prompt) end
            end
        end
    end
end

