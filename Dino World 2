local function createToggle(text, y, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 26)
    btn.Position = UDim2.new(0.05, 0, 0, y)
    btn.BackgroundColor3 = default and Color3.fromRGB(0, 145, 65) or Color3.fromRGB(45, 45, 55)
    btn.Text = text .. (default and " : ON" or " : OFF")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.Parent = main
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 145, 65) or Color3.fromRGB(45, 45, 55)
        btn.Text = text .. (state and " : ON" or " : OFF")
        callback(state)
    end)
end

local function createValueControl(text, y, currentValue, min, max, step, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.9, 0, 0, 18)
    label.Position = UDim2.new(0.05, 0, 0, y)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. currentValue
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.Parent = main

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 40, 0, 24)
    minus.Position = UDim2.new(0.05, 0, 0, y + 20)
    minus.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    minus.Text = "-"
    minus.TextColor3 = Color3.new(1,1,1)
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 16
    minus.Parent = main
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 5)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 40, 0, 24)
    plus.Position = UDim2.new(0.75, 0, 0, y + 20)
    plus.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    plus.Text = "+"
    plus.TextColor3 = Color3.new(1,1,1)
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 16
    plus.Parent = main
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 5)

    local value = currentValue

    local function update()
        label.Text = text .. ": " .. value
        callback(value)
    end

    minus.MouseButton1Click:Connect(function()
        value = math.max(min, value - step)
        update()
    end)

    plus.MouseButton1Click:Connect(function()
        value = math.min(max, value + step)
        update()
    end)
end

