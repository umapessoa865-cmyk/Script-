-- SLIDER
local arrastando = false
sliderBg.MouseButton1Down:Connect(function() arrastando = true end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then arrastando = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if arrastando and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mouseX = input.Position.X
        local pos = (mouseX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X
        pos = math.clamp(pos, 0, 1)
        sliderBar.Size = UDim2.new(pos, 0, 1, 0)
        alcance = 1 + (pos * 8)
        sliderLabel.Text = string.format("%.1fx", alcance)
        if ativo then
            for _, npc in pairs(npcs) do
                local h = npc:FindFirstChild("HitboxBorda")
                if h then h.Size = Vector3.new(6, 6, 6) * alcance end
            end
        end
    end
end)

