local ativo = false
local alcance = 2.0
local npcs = {}
local mortos = {}
local atacando = {}

-- ============================================
-- SCANEAR (MELHORADO)
-- ============================================
local function scanear()
    npcs = {}
    mortos = {}
    atacando = {}
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health and hum.Health > 0 then
                if obj ~= character and obj.Name ~= player.Name then
                    -- Verifica se é inimigo (por nome ou atributo)
                    local ehInimigo = true
                    local nome = obj.Name:lower()
                    if nome:find("chest") or nome:find("spawn") or nome:find("door") or nome:find("plate") then
                        ehInimigo = false
                    end
                    if ehInimigo then
                        table.insert(npcs, obj)
                    end
                end
            end
        end
    end
    
    npcCount.Text = "NPCs: " .. #npcs
    log.Text = "✅ Scan: " .. #npcs .. " NPCs"
    print("✅ Scan: " .. #npcs .. " NPCs")
end

-- ============================================
-- CRIAR HITBOX (COM DANO CONTÍNUO)
-- ============================================
local function criarHitbox(npc)
    if mortos[npc] then return end
    if not npc or not npc.Parent then return end
    
    local antiga = npc:FindFirstChild("HitboxBorda")
    if antiga then antiga:Destroy() end
    
    local root = npc:FindFirstChild("HumanoidRootPart")
    if not root then
        root = npc:FindFirstChild("Head")
    end
    if not root then return end
    
    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxBorda"
    hitbox.Size = Vector3.new(6, 6, 6) * alcance
    hitbox.Position = root.Position
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.Transparency = 0.4
    hitbox.BrickColor = BrickColor.new("Bright red")
    hitbox.Material = Enum.Material.Neon
    hitbox.Parent = npc
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.3
    highlight.Parent = hitbox
    
    -- ============================================
    -- SISTEMA DE DANO CONTÍNUO
    -- ============================================
    local danoContinuo = nil
    
    hitbox.Touched:Connect(function(other)
        if not ativo then return end
        if not other then return end
        if not other:IsDescendantOf(character) then return end
        if mortos[npc] then return end
        
        local hum = npc:FindFirstChild("Humanoid")
        if not hum then return end
        if hum.Health <= 0 then
            mortos[npc] = true
            hitbox:Destroy()
            return
        end
        
        -- Se já estiver atacando, não inicia outro loop
        if atacando[npc] then return end
        atacando[npc] = true
        
        -- Loop de dano contínuo enquanto o jogador estiver encostando
        danoContinuo = task.spawn(function()
            local contador = 0
            while ativo and not mortos[npc] and hum and hum.Health > 0 do
                -- Aplica dano a cada 0.15 segundos
                local dano = 8 * alcance
                local sucesso = aplicarDano(npc, dano)
                
                if sucesso then
                    contador = contador + 1
                    log.Text = "💥 " .. dano .. " (" .. npc.Name .. ")"
                    status.Text = "⚔️ ATACANDO!"
                    status.TextColor3 = Color3.fromRGB(255, 200, 0)
                end
                
                -- Verifica se morreu
                if hum.Health <= 0 then
                    hum.Health = 0
                    mortos[npc] = true
                    hitbox:Destroy()
                    log.Text = "💀 " .. npc.Name .. " MORREU!"
                    status.Text = "💀 MORTO!"
                    status.TextColor3 = Color3.fromRGB(255, 0, 0)
                    -- Remove da lista
                    for i = #npcs, 1, -1 do
                        if npcs[i] == npc then
                            table.remove(npcs, i)
                            break
                        end
                    end
                    npcCount.Text = "NPCs: " .. #npcs
                    break
                end
                
                task.wait(0.15) -- Dano contínuo
            end
            atacando[npc] = nil
        end)
    end)
    
    -- Quando o jogador sair da hitbox, interrompe o dano
    local function onTouchEnded()
        if danoContinuo then
            task.cancel(danoContinuo)
            danoContinuo = nil
        end
        atacando[npc] = nil
    end
    
    -- Detecta quando o jogador sai da hitbox
    hitbox.TouchEnded:Connect(function(other)
        if other and other:IsDescendantOf(character) then
            onTouchEnded()
        end
    end)
end

-- ============================================
-- LOOP DE ATUALIZAÇÃO (MAIS LEVE)
-- ============================================
local function atualizar()
    if not ativo then return end
    
    for i = #npcs, 1, -1 do
        local npc = npcs[i]
        if not npc or not npc.Parent then
            table.remove(npcs, i)
            continue
        end
        
        local hum = npc:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            mortos[npc] = true
            local h = npc:FindFirstChild("HitboxBorda")
            if h then h:Destroy() end
            table.remove(npcs, i)
            continue
        end
        
        local hitbox = npc:FindFirstChild("HitboxBorda")
        if hitbox then
            local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
            if root then
                hitbox.Position = root.Position
                hitbox.Size = Vector3.new(6, 6, 6) * alcance
            end
        elseif not mortos[npc] then
            criarHitbox(npc)
        end
    end
    
    npcCount.Text = "NPCs: " .. #npcs
end

RunService.Stepped:Connect(atualizar)

