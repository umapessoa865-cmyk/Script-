-- VARIÁVEIS
local ativo = false
local alcance = 2.0
local npcs = {}
local mortos = {}

-- SCANEAR
local function scanear()
    npcs = {}
    mortos = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health and hum.Health > 0 and obj ~= character and obj.Name ~= player.Name then
                table.insert(npcs, obj)
            end
        end
    end
    npcCount.Text = "NPCs: " .. #npcs
    log.Text = "✅ Scan: " .. #npcs .. " NPCs"
end

-- CRIAR HITBOX
local function criarHitbox(npc)
    if mortos[npc] then return end
    local antiga = npc:FindFirstChild("HitboxBorda")
    if antiga then antiga:Destroy() end
    local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
    if not root then return end

    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxBorda"
    hitbox.Size = Vector3.new(6, 6, 6) * alcance
    hitbox.Position = root.Position
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.Transparency = 0.4
    hitbox.BrickColor = BrickColor.new("Bright red")
    hitbox.Material = Enum.Material.Neon
    hitbox.Parent = npc

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.5
    highlight.Parent = hitbox

    hitbox.Touched:Connect(function(other)
        if not ativo then return end
        if not other or not other:IsDescendantOf(character) then return end
        local hum = npc:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            mortos[npc] = true
            if hitbox then hitbox:Destroy() end
            return
        end
        local dano = 10 * alcance
        hum.Health = hum.Health - dano
        log.Text = "💥 " .. dano .. " (" .. npc.Name .. ")"
        if hum.Health <= 0 then
            hum.Health = 0
            mortos[npc] = true
            if hitbox then hitbox:Destroy() end
            for i = #npcs, 1, -1 do
                if npcs[i] == npc then table.remove(npcs, i) break end
            end
            npcCount.Text = "NPCs: " .. #npcs
            log.Text = "💀 " .. npc.Name .. " MORREU!"
        end
    end)
end

-- LOOP
RunService.Stepped:Connect(function()
    if not ativo then return end
    for i = #npcs, 1, -1 do
        local npc = npcs[i]
        if not npc or not npc.Parent then
            table.remove(npcs, i)
            continue
        end
        local hum = npc:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            mortos[npc] = true
            local h = npc:FindFirstChild("HitboxBorda")
            if h then h:Destroy() end
            table.remove(npcs, i)
            continue
        end
        local hitbox = npc:FindFirstChild("HitboxBorda")
        if hitbox then
            local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
            if root then
                hitbox.Position = root.Position
                hitbox.Size = Vector3.new(6, 6, 6) * alcance
            end
        else
            criarHitbox(npc)
        end
    end
    npcCount.Text = "NPCs: " .. #npcs
end)

-- NOVOS NPCs
Workspace.ChildAdded:Connect(function(child)
    task.wait(0.3)
    if child:IsA("Model") and child:FindFirstChild("Humanoid") then
        local hum = child:FindFirstChild("Humanoid")
        if hum and hum.Health and hum.Health > 0 and child ~= character and child.Name ~= player.Name then
            local existe = false
            for _, n in pairs(npcs) do if n == child then existe = true break end end
            if not existe then
                table.insert(npcs, child)
                if ativo then criarHitbox(child) end
                npcCount.Text = "NPCs: " .. #npcs
                log.Text = "🆕 " .. child.Name
            end
        end
    end
end)

