-- ============================================
-- DETECTOR DE SISTEMA DE DANO
-- ============================================
local sistemaDano = {
    tipo = "humanoid",
    remote = nil,
    atributo = nil
}

-- Função para detectar remotes de dano
local function detectarRemotes()
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local nome = obj.Name:lower()
            if nome:find("damage") or nome:find("attack") or nome:find("hit") or 
               nome:find("combat") or nome:find("enemy") or nome:find("monster") then
                return obj
            end
        end
    end
    return nil
end

-- Função para detectar atributos de vida
local function detectarAtributos()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
            local atts = obj:GetAttributes()
            for nome, valor in pairs(atts) do
                if type(valor) == "number" and (nome:lower():find("health") or nome:lower():find("hp") or nome:lower():find("vida")) then
                    return nome
                end
            end
        end
    end
    return nil
end

-- Detectar sistema
local remote = detectarRemotes()
local atributo = detectarAtributos()

if remote then
    sistemaDano.tipo = "remote"
    sistemaDano.remote = remote
    print("✅ Sistema de dano: RemoteEvent (" .. remote.Name .. ")")
elseif atributo then
    sistemaDano.tipo = "atributo"
    sistemaDano.atributo = atributo
    print("✅ Sistema de dano: Atributo (" .. atributo .. ")")
else
    sistemaDano.tipo = "humanoid"
    print("✅ Sistema de dano: Humanoid padrão")
end

-- ============================================
-- FUNÇÃO PODEROSA DE APLICAR DANO
-- ============================================
local function aplicarDano(npc, quantidade)
    if not npc then return false end
    
    local hum = npc:FindFirstChild("Humanoid")
    if not hum then return false end
    
    -- MÉTODO 1: Humanoid
    if sistemaDano.tipo == "humanoid" then
        local sucesso, erro = pcall(function()
            hum.Health = hum.Health - quantidade
        end)
        if sucesso then return true end
    end
    
    -- MÉTODO 2: RemoteEvent
    if sistemaDano.tipo == "remote" and sistemaDano.remote then
        local sucesso, erro = pcall(function()
            if sistemaDano.remote:IsA("RemoteEvent") then
                sistemaDano.remote:FireServer(quantidade, npc)
            else
                sistemaDano.remote:InvokeServer(quantidade, npc)
            end
        end)
        if sucesso then return true end
    end
    
    -- MÉTODO 3: Atributo
    if sistemaDano.tipo == "atributo" and sistemaDano.atributo then
        local att = npc:GetAttribute(sistemaDano.atributo)
        if att and type(att) == "number" then
            local sucesso, erro = pcall(function()
                npc:SetAttribute(sistemaDano.atributo, att - quantidade)
            end)
            if sucesso then return true end
        end
    end
    
    -- MÉTODO 4: Tentar todos os remotes (fallback)
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local sucesso, erro = pcall(function()
                obj:FireServer(quantidade, npc)
            end)
            if sucesso then return true end
        end
    end
    
    return false
end

