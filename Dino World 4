local remote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
local espFolder = Instance.new("Folder", Workspace)
espFolder.Name = "DinoESP_Opt"

local function clearESP()
    for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end
end

local function createESP(part, text, color)
    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.new(0, 110, 0, 24)
    bb.StudsOffset = Vector3.new(0, 2.4, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0.5
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.Parent = bb
end

local function isDino(name)
    local l = string.lower(name)
    for _, k in ipairs(dinoKeywords) do
        if string.find(l, k) then return true end
    end
    return false
end

local function isTree(name)
    local l = string.lower(name)
    return (string.find(l, "tree") or string.find(l, "árvore") or string.find(l, "arvore")) 
        and not string.find(l, "leaf") and not string.find(l, "folha")
end

local function getEquippedTool()
    if not Character then return nil end
    for _, v in pairs(Character:GetChildren()) do
        if v:IsA("Tool") then return v.Name end
    end
    return nil
end

local function fireTool(tool, activated, pos)
    if not tool or not remote then return end
    pcall(function()
        remote:FireServer(buffer.fromstring("\001\001"), {{"Tool", "Activated", tool, activated, vector.create(pos.X, pos.Y, pos.Z)}})
    end)
end

local function getClosestTree()
    if not Root then return nil end
    local closest, dist = nil, Config.AutoWood.Distance
    for _, obj in pairs(Workspace:GetChildren()) do -- mais leve que GetDescendants
        if obj:IsA("Model") and isTree(obj.Name) then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local d = (Root.Position - part.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = part
                end
            end
        end
    end
    return closest
end

local function collectNearby()
    if not Root then return end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if woodNames[obj.Name] or fossilNames[obj.Name] then
            local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part and (Root.Position - part.Position).Magnitude < 20 then
                local prompt = part:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    -- Tenta segurar o prompt (melhor pro sistema de hold)
                    pcall(function()
                        fireproximityprompt(prompt, 1) -- 1 = hold time aproximado
                    end)
                end
            end
        end
    end
end

local originalCFrame = nil

-- ==================== LOOPS OTIMIZADOS ====================
-- ESP (mais lento = menos lag)
task.spawn(function()
    while true do
        task.wait(1.8)
        clearESP()
        if not Root then continue end

        for _, obj in pairs(Workspace:GetChildren()) do
            local name = obj.Name
            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart"))
            if not part then continue end
            local d = (Root.Position - part.Position).Magnitude
            if d > Config.ESP.MaxDistance then continue end

            if Config.ESP.Dinosaurs and isDino(name) and obj:FindFirstChildOfClass("Humanoid") then
                createESP(part, name .. " [" .. math.floor(d) .. "m]", Color3.fromRGB(255, 70, 70))
            end
            if Config.ESP.Fossils and fossilNames[name] then
                createESP(part, "Fóssil", Color3.fromRGB(255, 200, 50))
            end
            if Config.ESP.Wood and woodNames[name] then
                createESP(part, "Madeira", Color3.fromRGB(50, 220, 80))
            end
        end
    end
end)

-- Auto Madeira + Collect + KillAura (um loop só)
task.spawn(function()
    while true do
        task.wait(0.45)
        if not Root then continue end

        local tool = getEquippedTool()

        -- Auto Madeira (teleporta, corta, volta)
        if Config.AutoWood.Enabled and tool then
            local tree = getClosestTree()
            if tree then
                if not originalCFrame then originalCFrame = Root.CFrame end
                Root.CFrame = tree.CFrame * CFrame.new(0, 0, 4)
                task.wait(0.25)
                fireTool(tool, true, tree.Position)
                task.wait(0.15)
                fireTool(tool, false, tree.Position)
                task.wait(0.3)
                if Config.AutoWood.Return and originalCFrame then
                    Root.CFrame = originalCFrame
                end
            end
        end

        -- Auto Collect
        if Config.AutoCollect then
            collectNearby()
        end

        -- Kill Aura
        if Config.KillAura.Enabled and tool then
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj:IsA("Model") and isDino(obj.Name) and obj:FindFirstChildOfClass("Humanoid") then
                    local part = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
                    if part and (Root.Position - part.Position).Magnitude <= Config.KillAura.Distance then
                        fireTool(tool, true, part.Position)
                        task.wait(0.08)
                        fireTool(tool, false, part.Position)
                    end
                end
            end
        end
    end
end)

