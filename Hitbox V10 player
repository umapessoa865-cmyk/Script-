-- ============================================
-- DETECTOR DE SISTEMA DE DANO
-- ============================================
local sistemaDano = { tipo = "humanoid", remote = nil, atributo = nil }

local function detectarRemotes()
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local nome = obj.Name:lower()
            if nome:find("damage") or nome:find("attack") or nome:find("hit") or 
               nome:find("combat") or nome:find("enemy") or nome:find("monster") then
                return obj
            end
        end
    end
    return nil
end

local remote = detectarRemotes()
if remote then
    sistemaDano.tipo = "remote"
    sistemaDano.remote = remote
else
    sistemaDano.tipo = "humanoid"
end

print("✅ Sistema de dano: " .. sistemaDano.tipo)

-- ============================================
-- FUNÇÃO DE DANO EM PLAYERS
-- ============================================
local function aplicarDano(alvo, quantidade)
    if not alvo then return false end
    
    local hum = alvo:FindFirstChild("Humanoid")
    if not hum then return false end

    -- Método 1: Humanoid direto
    if sistemaDano.tipo == "humanoid" then
        pcall(function() hum.Health = hum.Health - quantidade end)
        return true
    end
    
    -- Método 2: RemoteEvent (se detectado)
    if sistemaDano.tipo == "remote" and sistemaDano.remote then
        pcall(function()
            if sistemaDano.remote:IsA("RemoteEvent") then
                sistemaDano.remote:FireServer(quantidade, alvo)
            else
                sistemaDano.remote:InvokeServer(quantidade, alvo)
            end
        end)
        return true
    end
    
    -- Método 3: Tentar todos os remotes (fallback)
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            pcall(function() obj:FireServer(quantidade, alvo) end)
        end
    end
    
    return false
end

