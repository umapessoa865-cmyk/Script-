-- ESP
task.spawn(function()
    while true do
        task.wait(1.3)
        clearESP()
        if not Root then continue end
        for _, obj in pairs(Workspace:GetDescendants()) do
            local name = obj.Name
            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
            if not part then continue end
            local dist = (Root.Position - part.Position).Magnitude
            if dist > Config.ESP.MaxDistance then continue end

            if Config.ESP.Dinosaurs and isDino(name) and obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                createESP(part, name .. " [" .. math.floor(dist) .. "m]", Color3.fromRGB(255, 65, 65))
            end
            if Config.ESP.Fossils and fossilNames[name] then
                createESP(part, "Fóssil", Color3.fromRGB(255, 200, 50))
            end
            if Config.ESP.Wood and woodNames[name] then
                createESP(part, "Madeira", Color3.fromRGB(50, 220, 80))
            end
        end
    end
end)

-- Auto Wood + Collect + Kill Aura
task.spawn(function()
    while true do
        task.wait(0.32)
        if not Root then continue end

        local tool = getEquippedTool()
        toolLabel.Text = "Ferramenta: " .. (tool or "Nenhuma")

        if Config.AutoWood.Enabled and tool then
            local tree = getClosestTree()
            if tree then
                fireTool(tool, true, tree.Position)
                task.wait(0.1)
                fireTool(tool, false, tree.Position)
            end
        end

        if Config.AutoCollect then
            collectNearby()
        end

        if Config.KillAura.Enabled then
            doKillAura()
        end
    end
end)

