local function isDino(name)
    local lower = string.lower(name)
    for _, key in ipairs(dinoKeywords) do
        if string.find(lower, key) then return true end
    end
    return false
end

local function isTree(name)
    local lower = string.lower(name)
    if string.find(lower, "tree") or string.find(lower, "árvore") or string.find(lower, "arvore") then
        if not string.find(lower, "leaf") and not string.find(lower, "folha") and not string.find(lower, "wood") then
            return true
        end
    end
    return false
end

local function getEquippedTool()
    if not Character then return nil end
    for _, item in pairs(Character:GetChildren()) do
        if item:IsA("Tool") then return item.Name end
    end
    return nil
end

local function fireTool(toolName, activated, pos)
    if not toolName then return end
    local args = {
        buffer.fromstring("\001\001"),
        {{"Tool", "Activated", toolName, activated, vector.create(pos.X, pos.Y, pos.Z)}}
    }
    pcall(function() remote:FireServer(unpack(args)) end)
end

local function getClosestTree()
    if not Root then return nil end
    local closest, shortest = nil, Config.AutoWood.Distance
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and isTree(obj.Name) then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (Root.Position - part.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = part
                end
            end
        end
    end
    return closest
end

local function collectNearby()
    if not Root then return end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if woodNames[obj.Name] or fossilNames[obj.Name] then
            local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
            if part and (Root.Position - part.Position).Magnitude < 28 then
                local prompt = part:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then pcall(fireproximityprompt, prompt) end
            end
        end
    end
end

local function doKillAura()
    if not Root or not Config.KillAura.Enabled then return end
    local tool = getEquippedTool()
    if not tool then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and isDino(obj.Name) and obj:FindFirstChildOfClass("Humanoid") then
            local part = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (Root.Position - part.Position).Magnitude
                if dist <= Config.KillAura.Distance then
                    fireTool(tool, true, part.Position)
                    task.wait(0.08)
                    fireTool(tool, false, part.Position)
                end
            end
        end
    end
end

