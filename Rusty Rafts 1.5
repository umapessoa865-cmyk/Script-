-- ==================== FUNCOES ====================
local function isLocalCharacter(model)
    if not model then return true end
    if model == LocalPlayer.Character then return true end
    if LocalPlayer.Character and model:IsDescendantOf(LocalPlayer.Character) then return true end
    return false
end

local function isVisible(fromPos, toPos)
    local dir = toPos - fromPos
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}

    local hit = Workspace:Raycast(fromPos, dir, params)
    if not hit then return true end
    return (hit.Position - toPos).Magnitude < 5
end

local function getClosestNPC()
    local closest, shortest = nil, Config.AimbotDist
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local myHead = char and char:FindFirstChild("Head")
    if not myRoot then return nil, 0 end

    local origin = myHead and myHead.Position or myRoot.Position

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            if not isLocalCharacter(obj) then
                local isPlayer = false
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr.Character == obj then
                        isPlayer = true
                        break
                    end
                end

                if not isPlayer then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local part = obj:FindFirstChild("Head")
                            or obj:FindFirstChild("HumanoidRootPart")
                            or obj.PrimaryPart
                            or obj:FindFirstChildWhichIsA("BasePart")

                        if part then
                            local dist = (myRoot.Position - part.Position).Magnitude
                            if dist > 5 and dist < shortest then
                                local canAim = true
                                if Config.WallCheck then
                                    if not isVisible(origin, part.Position) then
                                        canAim = false
                                    end
                                end
                                if canAim then
                                    shortest = dist
                                    closest = part
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest, shortest
end

local function findSail()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, 9999 end

    local best, bestDist = nil, 9999
    for _, obj in pairs(Workspace:GetDescendants()) do
        local n = string.lower(obj.Name)
        if string.find(n, "sail") or string.find(n, "vela")
        or string.find(n, "flag") or string.find(n, "bandeira")
        or string.find(n, "mast") or string.find(n, "mastro") then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart") or obj.PrimaryPart
            if part then
                local d = (root.Position - part.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = part
                end
            end
        end
    end
    return best, bestDist
end

local function teleportToSail(force)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local sail, dist = findSail()
    if not root then
        Status.Text = "Sem personagem"
        return
    end
    if not sail then
        Status.Text = "Vela nao encontrada"
        return
    end
    if not force and dist <= Config.BoatMinDist then
        Status.Text = "Ja perto da vela (" .. math.floor(dist) .. "m)"
        return
    end
    root.CFrame = sail.CFrame + Vector3.new(0, 4, 0)
    Config.lastBoatTP = tick()
    Status.Text = "TP na vela OK"
end

local function getOtherPlayers()
    local list = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if not (plr == LocalPlayer) then
            table.insert(list, plr)
        end
    end
    return list
end

TpVelaBtn.MouseButton1Click:Connect(function()
    teleportToSail(true)
end)

NextPlayerBtn.MouseButton1Click:Connect(function()
    local list = getOtherPlayers()
    if #list == 0 then
        PlayerLabel.Text = "Player: nenhum online"
        selectedPlayer = nil
        return
    end
    playerIndex = playerIndex + 1
    if playerIndex > #list then playerIndex = 1 end
    selectedPlayer = list[playerIndex]
    PlayerLabel.Text = "Player: " .. selectedPlayer.Name
end)

TpPlayerBtn.MouseButton1Click:Connect(function()
    if not selectedPlayer then
        Status.Text = "Escolha um player"
        return
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local target = selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root and target then
        root.CFrame = target.CFrame + Vector3.new(0, 3, 0)
        Status.Text = "TP em " .. selectedPlayer.Name
    else
        Status.Text = "Player sem personagem"
    end
end)

-- ==================== LOOPS ====================
RunService.RenderStepped:Connect(function()
    if not Config.Aimbot then return end

    local target, dist = getClosestNPC()
    if target then
        local cam = Camera.CFrame
        Camera.CFrame = cam:Lerp(CFrame.new(cam.Position, target.Position), Config.AimbotSmooth)
        local txt = dist <= 35 and "PERTO" or (dist <= 90 and "MEDIO" or "LONGE")
        Status.Text = "Aimbot " .. txt .. " (" .. math.floor(dist) .. "m)"
    else
        Status.Text = "Aimbot: nenhum visivel"
    end
end)

task.spawn(function()
    while true do
        task.wait(0.7)
        if Config.AutoTPBoat then
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local pct = (hum.Health / hum.MaxHealth) * 100
                if pct <= Config.HealthPercent then
                    if tick() - Config.lastBoatTP > Config.BoatCooldown then
                        Status.Text = "Vida baixa -> TP vela"
                        teleportToSail(false)
                    end
                end
            end
        end
    end
end)

