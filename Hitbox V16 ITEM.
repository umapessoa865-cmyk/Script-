-- ============================================
-- FUNÇÃO: ENCONTRAR ITEM (BOLA, OBJETO, ETC)
-- ============================================
local function encontrarItem()
    -- Procura por objetos comuns em jogos
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local nome = obj.Name:lower()
            
            -- Palavras-chave para encontrar a bola/item
            if nome:find("ball") or 
               nome:find("bola") or 
               nome:find("item") or 
               nome:find("object") or
               nome:find("pickup") or
               nome:find("collect") or
               nome:find("orb") or
               nome:find("sphere") or
               nome:find("circle") or
               nome:find("target") then
                return obj
            end
        end
    end
    return nil
end

-- ============================================
-- FUNÇÃO: CRIAR HITBOX NO ITEM
-- ============================================
local function criarHitboxItem(item)
    if not item then return end
    
    -- Remove hitbox antiga
    local antiga = item:FindFirstChild("HitboxBorda")
    if antiga then antiga:Destroy() end
    
    -- Determina a posição do item
    local posicao
    if item:IsA("BasePart") then
        posicao = item.Position
    elseif item:IsA("Model") then
        local root = item:FindFirstChild("HumanoidRootPart") or item:FindFirstChild("Head") or item.PrimaryPart
        if root then
            posicao = root.Position
        else
            -- Tenta pegar a posição de qualquer parte
            for _, part in pairs(item:GetChildren()) do
                if part:IsA("BasePart") then
                    posicao = part.Position
                    break
                end
            end
        end
    end
    
    if not posicao then return end
    
    -- Cria a hitbox (tamanho fixo 5)
    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxBorda"
    hitbox.Size = Vector3.new(5, 5, 5)
    hitbox.Position = posicao
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.Transparency = 0.3
    hitbox.BrickColor = BrickColor.new("Bright red")
    hitbox.Material = Enum.Material.Neon
    hitbox.Parent = item
    
    -- Highlight para ficar mais visível
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.3
    highlight.Parent = hitbox
    
    -- Efeito de brilho
    local att = Instance.new("Attachment")
    att.Parent = hitbox
    
    local beam = Instance.new("Beam")
    beam.Attachment0 = att
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
    beam.Width0 = 2
    beam.Width1 = 2
    beam.Transparency = NumberSequence.new(0.5)
    beam.Parent = hitbox
    
    hitboxAtiva = hitbox
    return hitbox
end

-- ============================================
-- FUNÇÃO: ATUALIZAR POSIÇÃO DA HITBOX
-- ============================================
local function atualizarHitbox()
    if not ativo or not itemAlvo then
        if hitboxAtiva then
            hitboxAtiva:Destroy()
            hitboxAtiva = nil
        end
        return
    end
    
    if not hitboxAtiva or not hitboxAtiva.Parent then
        criarHitboxItem(itemAlvo)
        return
    end
    
    -- Atualiza a posição do item
    local posicao
    if itemAlvo:IsA("BasePart") then
        posicao = itemAlvo.Position
    elseif itemAlvo:IsA("Model") then
        local root = itemAlvo:FindFirstChild("HumanoidRootPart") or itemAlvo:FindFirstChild("Head") or itemAlvo.PrimaryPart
        if root then
            posicao = root.Position
        else
            for _, part in pairs(itemAlvo:GetChildren()) do
                if part:IsA("BasePart") then
                    posicao = part.Position
                    break
                end
            end
        end
    end
    
    if posicao then
        hitboxAtiva.Position = posicao
    end
end

