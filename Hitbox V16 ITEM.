-- ============================================
-- FUNÇÃO: PROCURAR ITEM E ATUALIZAR STATUS
-- ============================================
local function procurarItem()
    local item = encontrarItem()
    if item then
        itemAlvo = item
        itemStatus.Text = "📦 Item: " .. item.Name
        itemStatus.TextColor3 = Color3.fromRGB(80, 255, 80)
        log.Text = "✅ Item encontrado: " .. item.Name
        print("🎯 Item encontrado: " .. item.Name)
        
        if ativo then
            criarHitboxItem(item)
        end
    else
        itemAlvo = nil
        itemStatus.Text = "📦 Item: NENHUM"
        itemStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        log.Text = "❌ Nenhum item encontrado"
        print("❌ Nenhum item encontrado")
    end
end

