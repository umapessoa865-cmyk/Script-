-- Procura por novos itens a cada 2 segundos
task.spawn(function()
    while true do
        task.wait(2)
        if not ativo then
            -- Se estiver desativado, só atualiza o status
            local item = encontrarItem()
            if item then
                itemAlvo = item
                itemStatus.Text = "📦 Item: " .. item.Name
                itemStatus.TextColor3 = Color3.fromRGB(80, 255, 80)
            end
        end
    end
end)

-- Detecta quando algo entra no Workspace
