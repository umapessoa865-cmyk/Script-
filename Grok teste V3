-- ====================== FUNÇÕES ======================
local function IsNPC(character)
	return character and character:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(character)
end

local function IsPlayerCharacter(character)
	return character and Players:GetPlayerFromCharacter(character) ~= nil
end

local function ExpandPart(part)
	if not part or not part:IsA("BasePart") then return end
	if ExpandedParts[part] then return end

	-- Salva tamanho original
	OriginalSizes[part] = part.Size
	ExpandedParts[part] = true

	part.Size = part.Size * Settings.Multiplier
	part.Massless = true
	part.CanCollide = false

	if Settings.ShowVisual then
		part.Transparency = 0.65
		part.Color = Color3.fromRGB(255, 50, 50)
	end
end

local function RestorePart(part)
	if not part or not OriginalSizes[part] then return end
	part.Size = OriginalSizes[part]
	part.Transparency = 0
	part.Color = Color3.fromRGB(163, 162, 165) -- cor padrão aproximada
	ExpandedParts[part] = nil
	OriginalSizes[part] = nil
end

local function ProcessCharacter(character)
	if not character then return end

	local shouldExpand = false
	if Settings.TargetNPCs and IsNPC(character) then
		shouldExpand = true
	elseif Settings.TargetPlayers and IsPlayerCharacter(character) and character ~= LocalPlayer.Character then
		shouldExpand = true
	end

	if not shouldExpand then return end

	for _, partName in ipairs(Settings.PartsToExpand) do
		local part = character:FindFirstChild(partName)
		if part then
			ExpandPart(part)
		end
	end
end

local function RestoreAll()
	for part, _ in pairs(ExpandedParts) do
		if part and part.Parent then
			RestorePart(part)
		end
	end
	ExpandedParts = {}
	OriginalSizes = {}
end

local function RefreshAll()
	RestoreAll()
	if not Settings.Enabled then return end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
			ProcessCharacter(obj)
		end
	end
end

-- ====================== BOTÕES ======================
ToggleBtn.MouseButton1Click:Connect(function()
	Settings.Enabled = not Settings.Enabled
	if Settings.Enabled then
		ToggleBtn.Text = "Status: ON"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 60)
		RefreshAll()
	else
		ToggleBtn.Text = "Status: OFF"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
		RestoreAll()
	end
end)

local Multipliers = {2, 3, 4, 5, 6, 8, 10}
local MultiIndex = 3

MultiBtn.MouseButton1Click:Connect(function()
	MultiIndex = MultiIndex % #Multipliers + 1
	Settings.Multiplier = Multipliers[MultiIndex]
	MultiBtn.Text = "Multiplier: " .. Settings.Multiplier .. "x"
	if Settings.Enabled then
		RefreshAll()
	end
end)

NPCBtn.MouseButton1Click:Connect(function()
	Settings.TargetNPCs = not Settings.TargetNPCs
	NPCBtn.Text = "NPCs: " .. (Settings.TargetNPCs and "ON" or "OFF")
	if Settings.Enabled then RefreshAll() end
end)

PlayerBtn.MouseButton1Click:Connect(function()
	Settings.TargetPlayers = not Settings.TargetPlayers
	PlayerBtn.Text = "Players: " .. (Settings.TargetPlayers and "ON" or "OFF")
	if Settings.Enabled then RefreshAll() end
end)

-- ====================== LOOP + EVENTOS ======================
workspace.DescendantAdded:Connect(function(obj)
	if Settings.Enabled and obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
		task.wait(0.15)
		ProcessCharacter(obj)
	end
end)

-- Atualiza periodicamente (caso algum NPC resete o tamanho)
task.spawn(function()
	while true do
		if Settings.Enabled then
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
					ProcessCharacter(obj)
				end
			end
		end
		task.wait(1.5)
	end
end)

