    end
end

-- ============================================
-- CRIAR HITBOX
-- ============================================
local function criarHitboxPlayer(alvo)
    if mortos[alvo] then return end
    if not alvo or not alvo.Parent then return end
    
    local antiga = alvo:FindFirstChild("HitboxBorda")
    if antiga then antiga:Destroy() end
    
    local root = alvo:FindFirstChild("HumanoidRootPart") or alvo:FindFirstChild("Head")
    if not root then return end
    
    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxBorda"
    hitbox.Size = Vector3.new(tamanhoHitbox, tamanhoHitbox, tamanhoHitbox)
    hitbox.Position = root.Position
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.Transparency = 0.4
    hitbox.BrickColor = BrickColor.new("Bright red")
    hitbox.Material = Enum.Material.Neon
    hitbox.Parent = alvo
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 100, 255)
    highlight.OutlineTransparency = 0.3
    highlight.Parent = hitbox
    
    local danoLoop = nil
    
    hitbox.Touched:Connect(function(other)
        if not ativo then return end
        if not other or not other:IsDescendantOf(character) then return end
        if mortos[alvo] then return end
        
        -- VERIFICA SE TEM ITEM EQUIPADO
        if not temItemEquipado() then
            log.Text = "⚠️ Equipe um item para dar dano!"
            return
        end
        
        local hum = alvo:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            mortos[alvo] = true
            hitbox:Destroy()
            return
        end
        
        if atacando[alvo] then return end
        atacando[alvo] = true
        
        danoLoop = task.spawn(function()
            while ativo and not mortos[alvo] and hum and hum.Health > 0 do
                -- Verifica novamente se tem item
                if not temItemEquipado() then
                    log.Text = "⚠️ Item perdido! Equipe novamente."
                    break
                end
                
                local dano = 10 * (tamanhoHitbox / 6) -- Dano escala com o tamanho
                aplicarDano(alvo, dano)
                
                local nome = "Player"
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character == alvo then
                        nome = p.Name
                        break
                    end
                end
                
                log.Text = "💥 " .. dano .. " (" .. nome .. ")"
                
                if hum.Health <= 0 then
                    hum.Health = 0
                    mortos[alvo] = true
                    hitbox:Destroy()
                    log.Text = "💀 " .. nome .. " MORREU!"
                    
                    for i = #players, 1, -1 do
                        if players[i] == alvo then
                            table.remove(players, i)
                            break
                        end
                    end
                    counter.Text = "Players: " .. #players
                    break
                end
                
                task.wait(0.15)
            end
            atacando[alvo] = nil
        end)
    end)
    
    hitbox.TouchEnded:Connect(function(other)
        if other and other:IsDescendantOf(character) then
            if danoLoop then
                task.cancel(danoLoop)
                danoLoop = nil
            end
            atacando[alvo] = nil
        end
    end)
end

-- ============================================
-- LOOP PRINCIPAL
-- ============================================
RunService.Heartbeat:Connect(function()
    -- Atualiza status do item
    atualizarItemStatus()
    
    if not ativo then return end
    
    for i = #players, 1, -1 do
        local alvo = players[i]
        
        if not alvo or not alvo.Parent then
            table.remove(players, i)
            continue
        end
        
        local hum = alvo:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            mortos[alvo] = true
            local h = alvo:FindFirstChild("HitboxBorda")
            if h then h:Destroy() end
            table.remove(players, i)
            continue
        end
        
        local hitbox = alvo:FindFirstChild("HitboxBorda")
        if hitbox then
            local root = alvo:FindFirstChild("HumanoidRootPart") or alvo:FindFirstChild("Head")
            if root then
                hitbox.Position = root.Position
                hitbox.Size = Vector3.new(tamanhoHitbox, tamanhoHitbox, tamanhoHitbox)
            end
        elseif not mortos[alvo] then
            criarHitboxPlayer(alvo)
        end
    end
    
    counter.Text = "Players: " .. #players
end)

-- ============================================
-- DETECTAR NOVOS PLAYERS
-- ============================================
Players.PlayerAdded:Connect(function(p)
    task.wait(1)
    if p ~= player and p.Character then
        local char = p.Character
        local hum = char:FindFirstChild("Humanoid")
        if hum and hum.Health and hum.Health > 0 then
            local existe = false
            for _, a in pairs(players) do
                if a == char then existe = true break end
            end
            if not existe then
                table.insert(players, char)
                if ativo then criarHitboxPlayer(char) end
                counter.Text = "Players: " .. #players
                log.Text = "🆕 " .. p.Name .. " entrou!"
            end
        end
    end
end)

