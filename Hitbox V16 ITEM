-- ============================================
-- FUNÇÃO: PROCURAR BOLA
-- ============================================
local function procurarBola()
    local bola = encontrarBola()
    if bola then
        bolaAlvo = bola
        bolaStatus.Text = "⚽ Bola: " .. bola.Name
        bolaStatus.TextColor3 = Color3.fromRGB(80, 255, 80)
        log.Text = "✅ Bola encontrada: " .. bola.Name
        print("⚽ Bola encontrada: " .. bola.Name)
        
        if ativo then
            criarHitboxBola(bola)
        end
    else
        bolaAlvo = nil
        bolaStatus.Text = "⚽ Bola: NENHUMA"
        bolaStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        log.Text = "❌ Nenhuma bola encontrada"
        print("❌ Nenhuma bola encontrada")
    end
end

