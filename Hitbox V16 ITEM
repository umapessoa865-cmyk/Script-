-- ============================================
-- FUNÇÃO: ENCONTRAR A BOLA
-- ============================================
local function encontrarBola()
    -- Procura por objetos que parecem ser a bola
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local nome = obj.Name:lower()
            
            -- Palavras-chave para encontrar a bola
            if nome:find("ball") or 
               nome:find("bola") or 
               nome:find("soccer") or 
               nome:find("futebol") or
               nome:find("football") or
               nome:find("sphere") or
               nome:find("circle") then
                return obj
            end
        end
    end
    return nil
end

-- ============================================
-- FUNÇÃO: CRIAR HITBOX NA BOLA
-- ============================================
local function criarHitboxBola(bola)
    if not bola then return end
    
    -- Remove hitbox antiga
    local antiga = bola:FindFirstChild("HitboxBorda")
    if antiga then antiga:Destroy() end
    
    -- Determina a posição da bola
    local posicao
    if bola:IsA("BasePart") then
        posicao = bola.Position
    elseif bola:IsA("Model") then
        local root = bola:FindFirstChild("HumanoidRootPart") or bola:FindFirstChild("Head") or bola.PrimaryPart
        if root then
            posicao = root.Position
        else
            for _, part in pairs(bola:GetChildren()) do
                if part:IsA("BasePart") then
                    posicao = part.Position
                    break
                end
            end
        end
    end
    
    if not posicao then return end
    
    -- Cria a hitbox (tamanho 6 para cobrir bem a bola)
    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxBorda"
    hitbox.Size = Vector3.new(6, 6, 6)
    hitbox.Position = posicao
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.Transparency = 0.3
    hitbox.BrickColor = BrickColor.new("Bright red")
    hitbox.Material = Enum.Material.Neon
    hitbox.Parent = bola
    
    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.3
    highlight.Parent = hitbox
    
    -- Efeito de brilho
    local att = Instance.new("Attachment")
    att.Parent = hitbox
    
    local beam = Instance.new("Beam")
    beam.Attachment0 = att
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
    beam.Width0 = 2
    beam.Width1 = 2
    beam.Transparency = NumberSequence.new(0.5)
    beam.Parent = hitbox
    
    hitboxAtiva = hitbox
    return hitbox
end

-- ============================================
-- FUNÇÃO: ATUALIZAR POSIÇÃO DA HITBOX
-- ============================================
local function atualizarHitbox()
    if not ativo or not bolaAlvo then
        if hitboxAtiva then
            hitboxAtiva:Destroy()
            hitboxAtiva = nil
        end
        return
    end
    
    if not hitboxAtiva or not hitboxAtiva.Parent then
        criarHitboxBola(bolaAlvo)
        return
    end
    
    -- Atualiza a posição da bola
    local posicao
    if bolaAlvo:IsA("BasePart") then
        posicao = bolaAlvo.Position
    elseif bolaAlvo:IsA("Model") then
        local root = bolaAlvo:FindFirstChild("HumanoidRootPart") or bolaAlvo:FindFirstChild("Head") or bolaAlvo.PrimaryPart
        if root then
            posicao = root.Position
        else
            for _, part in pairs(bolaAlvo:GetChildren()) do
                if part:IsA("BasePart") then
                    posicao = part.Position
                    break
                end
            end
        end
    end
    
    if posicao then
        hitboxAtiva.Position = posicao
    end
end

